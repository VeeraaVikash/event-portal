<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for SRM Event Connect.

  IIS reads this file automatically; it is the Windows equivalent of .htaccess.
  It must sit in the site root alongside index.php. Nothing here is optional for
  an internet- or campus-facing deployment - see the "Deploying on IIS" section
  of README.md.
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- Never list directory contents. Without this, /reports/ returns an
         index of every uploaded report. -->
    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!--
          Paths the browser must never reach directly.

          reports  - report PDFs. Filenames are predictable, so a reachable
                     reports/ lets anyone enumerate them without logging in.
                     download_report.php serves these instead, after checking
                     the session. PHP still reads the folder from disk, which
                     this rule does not affect.
          includes - database credentials and CSRF/workflow helpers.
          migrations, scripts - CLI-only tools, not web endpoints.
          backups  - database dumps, if any are kept here.
          .git     - the entire repository history, including credentials from
                     before they were moved out. A served .git folder is a full
                     source and secret leak.
        -->
        <hiddenSegments>
          <add segment="reports" />
          <add segment="includes" />
          <add segment="migrations" />
          <add segment="scripts" />
          <add segment="backups" />
          <add segment=".git" />
          <add segment=".claude" />
        </hiddenSegments>

        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>

        <!-- Reports are capped at 20 MB in api_save_report.php; allow a little
             headroom for multipart overhead so the app's own error message is
             what the user sees, not an IIS 404.13. -->
        <requestLimits maxAllowedContentLength="21500000" />

        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="HEAD" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- IIS advertises its version by default. -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- Enable once the site is on HTTPS and you are sure it will stay
             there: browsers remember this for max-age seconds.
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        -->
      </customHeaders>
    </httpProtocol>

    <!-- Show IIS's own error pages instead of anything PHP might print. PHP's
         display_errors must also be Off in php.ini. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="403" />
      <remove statusCode="404" />
      <remove statusCode="500" />
      <error statusCode="403" path="/index.php" responseMode="ExecuteURL" />
      <error statusCode="404" path="/index.php" responseMode="ExecuteURL" />
      <error statusCode="500" path="/index.php" responseMode="ExecuteURL" />
    </httpErrors>

    <!--
      Redirect every request to HTTPS. Requires the URL Rewrite module
      (https://www.iis.net/downloads/microsoft/url-rewrite) and a certificate
      bound to the site. Uncomment once both are in place.

    <rewrite>
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    -->

  </system.webServer>
</configuration>
